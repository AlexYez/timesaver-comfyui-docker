{
  "name": "Timesaver ComfyUI",
  "imageName": "ghcr.io/alexyez/timesaver-comfyui-docker:cu128",
  "containerDiskInGb": 50,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "ports": "8188/http",
  "env": {
    "COMFY_DATA_DIR": "/workspace",
    "COMFY_PORT": "8188",
    "REQUIRE_PERSISTENT_MOUNT": "1",
    "INSTALL_CUSTOM_NODE_REQUIREMENTS": "1"
  }
}
